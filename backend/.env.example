# Cau hinh tom tat cuoc hop bang LLM (tuy chon).
# Neu khong dat SUMMARY_API_KEY, ung dung tu dong dung bo tom tat theo quy tac.
SUMMARY_API_KEY=
SUMMARY_BASE_URL=https://api.openai.com/v1
SUMMARY_MODEL=gpt-4o-mini
DEFAULT_LANGUAGE=vi
WHISPER_MODEL=base

# Bao mat khi chay production (bo trong = khong xac thuc, chi dung LAN tin cay).
# API_TOKEN=<chuoi ngau nhien, vd: openssl rand -hex 32>
# CORS_ORIGINS=https://app.example
# ALLOW_EXTERNAL_TRANSLATE=1   # cho phem fallback Google dich (mac dinh tat)
